# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# Platform DB (externally managed; apply db/schema changes manually)
# Host-run commands (uvicorn, local scripts) should normally use 127.0.0.1.
# Dockerized tests use PLATFORM_DB_DOCKER_HOST and default to host.docker.internal.
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_DOCKER_HOST=host.docker.internal
PLATFORM_DB_PORT=1433
PLATFORM_DB_USER=sa
PLATFORM_DB_PASSWORD=
PLATFORM_DB_NAME=PLF
PLATFORM_DB_REQUESTER_LOGIN=codex-api-local
PLATFORM_DB_CONNECT_TIMEOUT_SECONDS=5
PLATFORM_DB_PROFILE_FILE=config/mssql/local_docker_profiles.yaml
PLATFORM_DB_ENCRYPT=no
PLATFORM_DB_TRUST_SERVER_CERT=yes

# MSSQL metadata source profile (externally managed, read-only recommended)
# Common local pattern:
# - host-run:  MSSQL_METADATA_HOST=127.0.0.1
# - docker/test containers: MSSQL_METADATA_DOCKER_HOST=host.docker.internal
# The profile file maps dbProfileId -> database name on the same SQL Server instance.
# Prefer a read-only login. If your local Docker SQL Server only has sa today,
# use it only as a short bootstrap step and switch to a read-only login afterward.
MSSQL_ENABLE_LIVE_METADATA=0
MSSQL_METADATA_HOST=127.0.0.1
MSSQL_METADATA_DOCKER_HOST=host.docker.internal
MSSQL_METADATA_PORT=1433
MSSQL_METADATA_USER=sa
MSSQL_METADATA_PASSWORD=
MSSQL_METADATA_DB=master
MSSQL_METADATA_DEFAULT_PROFILE_ID=master
MSSQL_METADATA_PROFILE_FILE=config/mssql/local_docker_profiles.yaml
# PPM pilot discovery uses dbProfileId=ppm from the profile file; do not substitute PLF.
MSSQL_METADATA_ENCRYPT=no
MSSQL_METADATA_TRUST_SERVER_CERT=yes

# MCP / Browser tooling
CONTEXT7_API_KEY=
PLAYWRIGHT_BROWSERS_PATH=

# Dockerized test runner
TEST_DOCKER_COMPOSE_FILE=docker/test/docker-compose.yml
TEST_PYTHON_SERVICE=python-test
TEST_WEB_SERVICE=web-test

# App
APP_ENV=local
# Leave APP/MCP/WEB port empty to let Makefile derive them from the current worktree.
# Example: p01-* -> 8001/8101/3001, p04-* -> 8004/8104/3004.
WORKTREE_PORT_SLOT=
APP_PORT=
MCP_PORT=
WEB_PORT=
