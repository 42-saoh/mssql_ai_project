# Windows sandbox PLF + development PPM + P-GPT template.
# Copy selected values into .env; never commit .env or secret values.

PYTHON=python
PNPM=pnpm
DOCKER_COMPOSE="docker compose"

OPENAI_API_KEY=
LLM_REMOTE_PROVIDER=pgpt
# Use OPENAI_BASE_URL=http://<pgpt-host>/gpgpta01-gpt or an exact OPENAI_RESPONSES_URL.
OPENAI_BASE_URL=
OPENAI_RESPONSES_URL=
PGPT_MODEL_ANALYSIS=gpt-4o
PGPT_MODEL_FAST_TEST=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
LLM_ENABLE_REMOTE=0
LLM_ALLOW_SP_TEXT=0
LLM_LIVE_GATE=0
P32_LIVE_CONFIDENCE_GATE=0
P35_KNOWLEDGE_LIVE_GATE=0
LLM_SP_CONCURRENCY=2
AI_TOOL_MAX_CALLS=5
AI_TOOL_MAX_ROUNDS=2
AI_TOOL_LIVE_MAX_ROUNDS=1

# Windows may point platform persistence and metadata discovery at different SQL Server hosts.
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_DOCKER_HOST=host.docker.internal
PLATFORM_DB_PORT=1433
PLATFORM_DB_USER=sa
PLATFORM_DB_PASSWORD=
PLATFORM_DB_NAME=PLF
PLATFORM_DB_REQUESTER_LOGIN=codex-api-local
PLATFORM_DB_CONNECT_TIMEOUT_SECONDS=5

P21_LIVE_PORTAL_GATE=0
P21_METADATA_SEARCH_QUERY=proc
P15_HARD_LIVE_GATE=0
P27_HARD_LIVE_GATE=0
MSSQL_ENABLE_LIVE_METADATA=0
MSSQL_METADATA_HOST=
MSSQL_METADATA_DOCKER_HOST=
MSSQL_METADATA_PORT=1433
MSSQL_METADATA_USER=readonly_metadata_user
MSSQL_METADATA_PASSWORD=
MSSQL_METADATA_DB=master
MSSQL_METADATA_DEFAULT_PROFILE_ID=master
MSSQL_METADATA_PROFILE_FILE=config/mssql/local_docker_profiles.yaml
MSSQL_METADATA_CONNECT_TIMEOUT_SECONDS=20
MSSQL_METADATA_TDS_VERSION=7.4

MCP_TOOL_RESULT_CACHE_ENABLED=1
MCP_TOOL_RESULT_CACHE_TTL_SECONDS=300
MCP_TOOL_RESULT_CACHE_MAX_ENTRIES=1024
MSSQL_METADATA_MAX_CONCURRENCY=4
WORKFLOW_MAX_ACTIVE_JOBS=4
BACKPRESSURE_WAIT_MS=250
SP_BATCH_MAX_TARGETS=20
SP_BATCH_MAX_CONCURRENT_JOBS=2
KNOWLEDGE_ASSETIZATION_ENABLED=1

APP_ENV=local
PORTAL_API_MODE=http
PORTAL_API_BASE_URL=
WORKTREE_PORT_SLOT=
APP_PORT=
MCP_PORT=
WEB_PORT=
